APP_NAME="Ye Birhan Dana"
# Server defaults. On your own computer use: APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost/yebirhandana/public
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yebirhandana
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@yebirhandana.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- First Super Admin (created by the seeder) ---
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@yebirhandana.org
ADMIN_PASSWORD=change-me-now

# --- Telegram bot (create with @BotFather) ---
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=YeBirhanDanaBot
# Random string (A-Z a-z 0-9 _ -), sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=
# Defaults for the settings page (editable later in Admin → Settings → Bot)
TELEGRAM_FINANCE_GROUP_ID=
TELEGRAM_CHANNEL_ID=

# --- Optional Cloudflare Turnstile on the registration form ---
TURNSTILE_SECRET_KEY=

# --- Backups (spatie/laravel-backup) ---
BACKUP_ARCHIVE_PASSWORD=
